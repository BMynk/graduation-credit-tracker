# backend/.env.production

# ---------- Database ----------
DATABASE_URL=sqlite:///./credit_tracker.db

# ---------- JWT Security ----------
# Generate a real one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-production-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Security ----------
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com
SECURE_COOKIES=false  # Can set to true once HTTPS is enabled
PASSWORD_MIN_LENGTH=12
REQUIRE_UPPERCASE=true
REQUIRE_NUMBERS=true
REQUIRE_SPECIAL_CHARS=true
SESSION_TIMEOUT_MINUTES=30
MAX_SESSIONS_PER_USER=3
REQUIRE_MFA=false  # Set to true for extra security
RATE_LIMIT_ENABLED=true

# ---------- PIN ----------
PIN_EXPIRE_MINUTES=10

# ---------- CORS ----------
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ---------- Email ----------
EMAIL_DEV_MODE=true  # Set to false when SMTP is configured
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@credit-tracker.com
SMTP_USE_TLS=true

# ---------- Frontend ----------
BASE_URL=http://localhost:5173  # Change to https://yourdomain.com later

# ---------- Academic ----------
PASS_MARK=50
TYPICAL_CREDITS_PER_SEMESTER=48