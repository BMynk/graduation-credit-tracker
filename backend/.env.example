# Copy this file to .env and fill in real values before running in anything but local dev.

# Runtime mode. Keep development locally; set production on Render.\nENVIRONMENT=development\n\n# For local dev, SQLite is fine. For production, point this at Postgres, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/crm_db
DATABASE_URL=sqlite:///./credit_tracker.db

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_DEV_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
PIN_EXPIRE_MINUTES=10

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173